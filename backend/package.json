{
  "name": "@disc/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && node scripts/bundle.mjs",
    "dev": "prisma generate && nest start --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --passWithNoTests && vitest run --config vitest.nometadata.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "start": "node dist/main.js",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:nometadata": "vitest run --config vitest.nometadata.config.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@disc/contracts": "workspace:*",
    "@disc/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@disc/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "^1.11.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.12",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
