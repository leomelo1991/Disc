NODE_ENV=development
PORT=3000
# Dono do schema: só migrations e seed
DATABASE_URL=postgres://disc:disc@localhost:5432/disc
# Papel da API (sujeito a RLS). Obrigatória em produção.
APP_DATABASE_URL=postgres://disc_app:disc_app@localhost:5432/disc
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# Documentação interativa em /api/docs (padrão: ligada, exceto em produção)
# ENABLE_DOCS=true
# Observabilidade (opcional)
# SENTRY_DSN=https://<chave>@<org>.ingest.sentry.io/<projeto>
# METRICS_TOKEN=<token longo, mín. 16 caracteres>   # GET /api/v1/metrics com Authorization: Bearer

# Página pública /apresentacao (cria empresa de demonstração sem login). Padrão: ligada fora de produção.
# ENABLE_PRESENTATION=true
# PRESENTATION_DAILY_LIMIT=100
